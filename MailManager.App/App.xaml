<Application x:Class="MailManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MailManager.App.ViewModels"
             xmlns:views="clr-namespace:MailManager.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RegistrationViewModel}"><views:RegistrationView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountsViewModel}"><views:AccountsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:GeneratorsViewModel}"><views:GeneratorsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupsViewModel}"><views:BackupsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
