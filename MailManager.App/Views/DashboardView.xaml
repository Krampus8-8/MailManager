<UserControl x:Class="MailManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:MailManager.Core.Models;assembly=MailManager.Core"
             Style="{StaticResource PageFade}">
    <UserControl.Resources>
        <Style x:Key="HeroAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="103"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
        </Style>
        <Style x:Key="ToolAction" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="MinHeight" Value="47"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Statistics}" Margin="-5,0,-5,19">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="12,13" Margin="5,0" MinHeight="94">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="22" Background="{Binding Tint}"
                                    BorderBrush="{Binding Color}" BorderThickness=".5" Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Icon}" Foreground="{Binding Color}" FontSize="23"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" FontSize="13"/>
                                <TextBlock Text="{Binding Count}" FontSize="31" FontWeight="SemiBold" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="13"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Command="{Binding OpenSingle}" Style="{StaticResource HeroAction}" Background="{StaticResource HeroBrush}"
                    BorderBrush="#824DD5" AutomationProperties.Name="Создать одну почту">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="14" Background="#20FFFFFF" Margin="0,0,15,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FA;" Foreground="White" FontSize="28"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE72A;" Foreground="White" Margin="9,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Создать одну почту" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Подготовить логин и пароль" Foreground="#EEE3FF" TextWrapping="Wrap" FontWeight="Normal" Margin="0,5,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Grid.Column="2" Command="{Binding OpenQueue}" Style="{StaticResource HeroAction}"
                    AutomationProperties.Name="Создать несколько почт">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="14" Background="#302449" Margin="0,0,15,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE81E;" FontSize="26"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE72A;" Foreground="{StaticResource Muted}" Margin="9,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Создать несколько почт" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Подготовить очередь регистраций" Style="{StaticResource MutedText}" FontWeight="Normal" Margin="0,5,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Button>
        </Grid>

        <TextBlock Text="Почтовые сервисы" Style="{StaticResource SectionTitle}" Margin="0,0,0,11"/>
        <ItemsControl ItemsSource="{Binding Providers}" Margin="-6,0,-6,19">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="15,12" Margin="6,0" MinHeight="106">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Margin="0,0,11,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#242332"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Provider}" Value="{x:Static m:MailProvider.MailRu}">
                                                    <Setter Property="Background" Value="#2365F4"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Provider}" Value="{x:Static m:MailProvider.Yandex}">
                                                    <Setter Property="Background" Value="#F63E36"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Viewbox Width="28" Height="28">
                                            <Viewbox.Style>
                                                <Style TargetType="Viewbox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Provider}" Value="{x:Static m:MailProvider.Gmail}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Viewbox.Style>
                                            <Canvas Width="48" Height="48">
                                                <Path Fill="#EA4335" Data="M24,9 C28,9 31,10 34,13 L41,6 C36,2 31,0 24,0 C15,0 7,5 3,12 L11,18 C13,12 18,9 24,9 Z"/>
                                                <Path Fill="#FBBC05" Data="M11,18 L3,12 C-1,20 -1,28 3,36 L11,30 C10,26 10,22 11,18 Z"/>
                                                <Path Fill="#34A853" Data="M24,39 C18,39 13,36 11,30 L3,36 C7,43 15,48 24,48 C31,48 36,46 41,42 L33,36 C31,38 28,39 24,39 Z"/>
                                                <Path Fill="#4285F4" Data="M47,20 L24,20 L24,29 L37,29 C36,32 35,35 33,36 L41,42 C46,37 49,29 47,20 Z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Provider}" Value="{x:Static m:MailProvider.MailRu}">
                                                            <Setter Property="Text" Value="@"/>
                                                            <Setter Property="Foreground" Value="#FFDB56"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Provider}" Value="{x:Static m:MailProvider.Yandex}">
                                                            <Setter Property="Text" Value="Я"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Host}" Foreground="{StaticResource Subtle}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                            <Button Content="Регистрация ↗" Style="{StaticResource PrimaryButton}" Command="{Binding Open}"
                                    HorizontalAlignment="Right" Margin="0,8,0,0" MinHeight="29" Padding="11,5" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.05*"/>
                <ColumnDefinition Width="13"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="14" MinHeight="190">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Все аккаунты →"
                                Command="{Binding OpenAccounts}" FontSize="12"/>
                        <TextBlock Text="Последние аккаунты" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource EmptyCard}" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="Добавленные аккаунты появятся здесь." Style="{StaticResource MutedText}"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding Recent}" IsHitTestVisible="False" Focusable="False"
                              Visibility="{Binding IsEmpty, Converter={StaticResource HiddenWhen}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Почта" Binding="{Binding Email}" Width="1.5*"/>
                            <DataGridTextColumn Header="Сервис" Binding="{Binding Provider}" Width=".8*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Created, StringFormat={}{0:dd.MM.yy HH:mm}}" Width="114"/>
                            <DataGridTemplateColumn Header="Статус" CellTemplate="{StaticResource StatusCell}" Width="103"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Быстрые инструменты" Style="{StaticResource SectionTitle}" Margin="0,2,0,13"/>
                    <Button Command="{Binding OpenPasswords}" Style="{StaticResource ToolAction}" Margin="0,0,0,9"
                            AutomationProperties.Name="Генератор паролей">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE8D7;" Margin="0,0,10,0"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE72A;" FontSize="14" Margin="6,0,0,0"/>
                            <TextBlock Text="Генератор паролей" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button Command="{Binding OpenLogins}" Style="{StaticResource ToolAction}" AutomationProperties.Name="Генератор логинов">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE77B;" Margin="0,0,10,0"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE72A;" FontSize="14" Margin="6,0,0,0"/>
                            <TextBlock Text="Генератор логинов" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
