<UserControl x:Class="MailManager.App.Views.GeneratorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageFade}">
    <StackPanel>
        <WrapPanel Margin="0,0,0,14">
            <Button Content="Логины" Margin="0,0,7,0" Command="{Binding ShowLoginCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowPasswords}" Value="False">
                                <Setter Property="Background" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Пароли" Command="{Binding ShowPasswordCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowPasswords}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </WrapPanel>
        <Border Style="{StaticResource Card}" MaxWidth="620" HorizontalAlignment="Left" MinWidth="475"
                Visibility="{Binding ShowPasswords, Converter={StaticResource HiddenWhen}}">
            <StackPanel>
                <TextBlock Text="Генератор логинов" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                <TextBlock Text="Почтовый сервис" Style="{StaticResource FieldTitle}"/>
                <ComboBox ItemsSource="{Binding Providers}" SelectedValue="{Binding Provider}" AutomationProperties.Name="Почтовый сервис"/>
                <TextBlock Text="Вариант логина" Style="{StaticResource FieldTitle}" Margin="0,12,0,6"/>
                <ComboBox ItemsSource="{Binding Patterns}" SelectedValue="{Binding Pattern}" AutomationProperties.Name="Вариант логина"/>
                <TextBlock Text="Длина (6–30)" Style="{StaticResource FieldTitle}" Margin="0,12,0,6"/>
                <TextBox Text="{Binding LoginLength, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" AutomationProperties.Name="Длина логина"/>
                <TextBlock Text="Дубликаты проверяются среди локальных аккаунтов и открытых задач."
                           Style="{StaticResource MutedText}" Margin="0,11,0,13"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Копировать" Command="{Binding CopyLoginCommand}" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding Login, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Сгенерированный логин"/>
                </DockPanel>
                <Button Content="Сгенерировать логин" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}"
                        Margin="0,14,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" MaxWidth="620" HorizontalAlignment="Left" MinWidth="475"
                Visibility="{Binding ShowPasswords, Converter={StaticResource VisibleWhen}}">
            <StackPanel>
                <TextBlock Text="Генератор паролей" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                <TextBlock Text="Длина (12–128)" Style="{StaticResource FieldTitle}"/>
                <TextBox Text="{Binding PasswordLength, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" AutomationProperties.Name="Длина пароля"/>
                <TextBlock Text="Наборы символов" Style="{StaticResource FieldTitle}" Margin="0,12,0,6"/>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <CheckBox Content="Заглавные буквы" IsChecked="{Binding Upper}"/>
                    <CheckBox Content="Строчные буквы" IsChecked="{Binding Lower}"/>
                    <CheckBox Content="Цифры" IsChecked="{Binding Digits}"/>
                    <CheckBox Content="Специальные символы" IsChecked="{Binding Symbols}"/>
                </UniformGrid>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Копировать" Command="{Binding CopyPasswordCommand}" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding PasswordHint, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Состояние пароля"/>
                </DockPanel>
                <Button Content="Сгенерировать пароль" Style="{StaticResource PrimaryButton}" Command="{Binding PasswordCommand}"
                        Margin="0,14,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
