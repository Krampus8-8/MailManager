<UserControl x:Class="MailManager.App.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageFade}">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="133"/>
                        <ColumnDefinition Width="133"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                             ToolTip="Поиск по адресу или примечанию" AutomationProperties.Name="Поиск по адресу или примечанию"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ProviderFilters}" SelectedValue="{Binding ProviderFilter}"
                              Margin="0,0,8,0" AutomationProperties.Name="Фильтр по сервису"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding StatusFilters}" SelectedValue="{Binding StatusFilter}"
                              Margin="0,0,8,0" AutomationProperties.Name="Фильтр по статусу"/>
                    <Button Grid.Column="3" Content="+  Добавить аккаунт" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}"/>
                </Grid>
                <Border Style="{StaticResource EmptyCard}" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="По текущим фильтрам аккаунтов нет." Style="{StaticResource MutedText}"/>
                </Border>
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" MaxHeight="392"
                          Visibility="{Binding IsEmpty, Converter={StaticResource HiddenWhen}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Почта" Binding="{Binding Email}" Width="1.5*"/>
                        <DataGridTextColumn Header="Сервис" Binding="{Binding Provider}" Width="92"/>
                        <DataGridTextColumn Header="Дата создания" Binding="{Binding Created, StringFormat={}{0:dd.MM.yy HH:mm}}" Width="124"/>
                        <DataGridTemplateColumn Header="Статус" CellTemplate="{StaticResource StatusCell}" Width="105"/>
                        <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,13,0,0">
            <StackPanel>
                <TextBlock Text="{Binding EditTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Почта" Style="{StaticResource FieldTitle}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" AutomationProperties.Name="Почта"/>
                        <TextBlock Text="Статус" Style="{StaticResource FieldTitle}" Margin="0,12,0,6"/>
                        <ComboBox ItemsSource="{Binding Statuses}" SelectedValue="{Binding Status}" AutomationProperties.Name="Статус"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Почтовый сервис" Style="{StaticResource FieldTitle}"/>
                        <ComboBox ItemsSource="{Binding Providers}" SelectedValue="{Binding Provider}" AutomationProperties.Name="Почтовый сервис"/>
                        <TextBlock Text="Проверка телефона" Style="{StaticResource FieldTitle}" Margin="0,12,0,6"/>
                        <ComboBox ItemsSource="{Binding PhoneChecks}" SelectedValue="{Binding Phone}" AutomationProperties.Name="Проверка телефона"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Примечание" Style="{StaticResource FieldTitle}" Margin="0,12,0,6"/>
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="62" VerticalContentAlignment="Top" AutomationProperties.Name="Примечание"/>
                <WrapPanel Margin="0,14,0,0">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                    <Button Content="Копировать пароль" Command="{Binding CopyPasswordCommand}" Margin="0,0,8,0"/>
                    <Button Content="Удалить" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
