<UserControl x:Class="MailManager.App.Views.RegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageFade}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" MinWidth="354"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*" MinWidth="273"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,13">
                        <Button DockPanel.Dock="Right" Content="Новая задача" Style="{StaticResource LinkButton}" Command="{Binding NewCommand}"
                                Visibility="{Binding IsDraft, Converter={StaticResource HiddenWhen}}"/>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Visibility="{Binding CanRegister, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="Почтовый сервис" Style="{StaticResource FieldTitle}"/>
                        <ComboBox ItemsSource="{Binding Providers}" SelectedValue="{Binding Provider}" IsEnabled="{Binding IsDraft}"
                                  AutomationProperties.Name="Почтовый сервис"/>
                        <StackPanel Visibility="{Binding ShowGmailProfile, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="Имя" Style="{StaticResource FieldTitle}" Margin="0,13,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Копировать" Command="{Binding CopyFirstNameCommand}"
                                        Margin="6,0,0,0" AutomationProperties.Name="Копировать имя"/>
                                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsPending}"
                                         MaxLength="100" AutomationProperties.Name="Имя"/>
                            </DockPanel>
                            <TextBlock Text="Фамилия" Style="{StaticResource FieldTitle}" Margin="0,11,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Копировать" Command="{Binding CopyLastNameCommand}"
                                        Margin="6,0,0,0" AutomationProperties.Name="Копировать фамилию"/>
                                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsPending}"
                                         MaxLength="100" AutomationProperties.Name="Фамилия"/>
                            </DockPanel>
                        </StackPanel>
                        <DockPanel Margin="0,13,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DomainHint}" Foreground="{StaticResource Subtle}"/>
                            <TextBlock Text="Логин" Style="{StaticResource FieldTitle}" Margin="0"/>
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Копировать" Command="{Binding CopyLoginCommand}" Margin="6,0,0,0"
                                    AutomationProperties.Name="Копировать логин"/>
                            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsPending}" MaxLength="32"
                                     AutomationProperties.Name="Логин"/>
                        </DockPanel>
                        <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource FieldTitle}" Margin="0,13,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Копировать" Command="{Binding CopyPasswordCommand}" Margin="6,0,0,0"
                                    AutomationProperties.Name="Копировать пароль"/>
                            <Grid>
                                <PasswordBox x:Name="DraftPasswordBox" MaxLength="128" PasswordChanged="DraftPasswordChanged"
                                             AutomationProperties.Name="{Binding PasswordLabel}"
                                             Visibility="{Binding CanEnterPassword, Converter={StaticResource VisibleWhen}}"/>
                                <TextBox Text="••••••••••••••••" IsReadOnly="True" IsTabStop="False"
                                         Visibility="{Binding CanEnterPassword, Converter={StaticResource HiddenWhen}}"
                                         AutomationProperties.Name="Пароль задачи сохранён"/>
                            </Grid>
                        </DockPanel>
                        <WrapPanel Margin="0,9,0,0" Visibility="{Binding IsDraft, Converter={StaticResource VisibleWhen}}">
                            <Button Content="Сгенерировать всё" Command="{Binding GenerateProfileCommand}" Margin="0,0,5,4"
                                    Visibility="{Binding ShowGmailProfile, Converter={StaticResource VisibleWhen}}"/>
                            <Button Style="{StaticResource LinkButton}" Content="Сгенерировать логин" Command="{Binding GenerateLoginCommand}"/>
                            <Button Style="{StaticResource LinkButton}" Content="Сгенерировать пароль" Command="{Binding GeneratePasswordCommand}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="{Binding CreateLabel}" Command="{Binding SaveTaskCommand}" Margin="0,0,7,6"
                                    Visibility="{Binding IsDraft, Converter={StaticResource VisibleWhen}}"/>
                            <Button Content="Открыть регистрацию ↗" Command="{Binding OpenSignupCommand}" Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,0,6"/>
                            <Button Content="Копировать для браузера" Command="{Binding CopyBrowserProfileCommand}" Margin="7,0,0,6"
                                    Visibility="{Binding ShowGmailProfile, Converter={StaticResource VisibleWhen}}"/>
                        </WrapPanel>
                        <Button Content="Сохранить расширение для Chrome и Edge…" Command="{Binding SaveGmailExtensionCommand}"
                                Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                Visibility="{Binding ShowGmailProfile, Converter={StaticResource VisibleWhen}}"/>
                        <TextBlock Text="Вставьте данные в боковую панель расширения. Если Google запросит номер телефона, подтвердите его на сайте."
                                   Style="{StaticResource MutedText}" Margin="0,7,0,0"
                                   Visibility="{Binding ShowGmailProfile, Converter={StaticResource VisibleWhen}}"/>
                        <TextBlock Text="Заполните форму в браузере и пройдите проверки сервиса."
                                   Style="{StaticResource MutedText}" Margin="0,7,0,0"
                                   Visibility="{Binding ShowGmailProfile, Converter={StaticResource HiddenWhen}}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsClosed, Converter={StaticResource VisibleWhen}}">
                        <DockPanel Margin="0,2,0,10">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding SelectedTask}" ContentTemplate="{StaticResource StatusCell}"/>
                            <TextBlock Text="{Binding Login}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedTask.Provider}" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding SelectedTask.Phone}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,13,0,0" Visibility="{Binding IsPending, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <TextBlock Text="Результат регистрации" Style="{StaticResource SectionTitle}" Margin="0,0,0,13"/>
                    <TextBlock Text="Фактический почтовый адрес (при успехе)" Style="{StaticResource FieldTitle}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" AutomationProperties.Name="Фактический адрес"/>
                    <TextBlock Text="Проверка телефона" Style="{StaticResource FieldTitle}" Margin="0,11,0,6"/>
                    <ComboBox ItemsSource="{Binding PhoneChecks}" SelectedValue="{Binding Phone}" AutomationProperties.Name="Проверка телефона"/>
                    <TextBlock Text="Примечание" Style="{StaticResource FieldTitle}" Margin="0,11,0,6"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap"
                             AcceptsReturn="True" MinHeight="58" VerticalContentAlignment="Top" AutomationProperties.Name="Примечание"/>
                    <CheckBox IsChecked="{Binding KeepPassword}" Margin="0,10,0,0">
                        <TextBlock Text="Сохранить пароль в Mail Manager" TextWrapping="Wrap"/>
                    </CheckBox>
                    <WrapPanel Margin="0,13,0,0">
                        <Button Content="Успешно" Command="{Binding SuccessCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,7,0"/>
                        <Button Content="Отметить ошибку" Command="{Binding FailureCommand}" Style="{StaticResource DangerButton}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding ListTitle}" Style="{StaticResource SectionTitle}"/>
                <StackPanel Visibility="{Binding IsQueue, Converter={StaticResource VisibleWhen}}">
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Следующая задача" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,7,6"/>
                        <Button Content="Импорт TXT / CSV" Command="{Binding ImportCommand}" Margin="0,0,0,6"
                                ToolTip="CSV: provider,login   ·   TXT: сервис|логин"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Progress}" Style="{StaticResource MutedText}" Margin="0,7,0,7"/>
                    <ProgressBar Value="{Binding CompletedCount, Mode=OneWay}" Maximum="{Binding Rows.Count, Mode=OneWay}" Height="5"
                                 Foreground="{StaticResource Accent}" Background="{StaticResource Input}" BorderThickness="0"/>
                </StackPanel>
                <Border Style="{StaticResource EmptyCard}" Margin="0,14,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="Сохраните первую задачу, чтобы она появилась в списке." Style="{StaticResource MutedText}"/>
                </Border>
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedTask}" MaxHeight="380" Margin="0,14,0,0"
                          Visibility="{Binding IsEmpty, Converter={StaticResource HiddenWhen}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="1.3*"/>
                        <DataGridTextColumn Header="Сервис" Binding="{Binding Provider}" Width=".85*" MinWidth="64"/>
                        <DataGridTemplateColumn Header="Статус" CellTemplate="{StaticResource StatusCell}" Width="106"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
