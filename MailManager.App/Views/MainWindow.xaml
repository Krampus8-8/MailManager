<Window x:Class="MailManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Mail Manager" Icon="/MailManager;component/Resources/MailManager.ico" WindowStartupLocation="CenterScreen"
        Width="1380" Height="860" MinWidth="900" MinHeight="560" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" Language="ru-RU">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="37" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18*" MinWidth="185" MaxWidth="230"/>
            <ColumnDefinition Width="82*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="19,21,13,18">
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource HeroBrush}" Width="43" Height="43" CornerRadius="11" Margin="0,0,12,0">
                                <TextBlock Text="&#xE715;" Style="{StaticResource Glyph}" FontSize="23" Foreground="White"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Mail Manager" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="v1.1.2" FontSize="12" Foreground="{StaticResource Subtle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Viewbox>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="22,20" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Data="M0,2 L7,1 7,7 0,7 Z M8,1 L16,0 16,7 8,7 Z M0,8 L7,8 7,14 0,13 Z M8,8 L16,8 16,16 8,14 Z"
                              Fill="{StaticResource Subtle}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock Text="Приложение для Windows" Foreground="{StaticResource Muted}" FontSize="12"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Navigation}" Margin="9,9" IsEnabled="{Binding CanInteract}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Style="{StaticResource Glyph}" Width="21" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,2,5,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="MinimizeWindow" ToolTip="Свернуть"
                        AutomationProperties.Name="Свернуть"/>
                <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="ToggleMaximizeWindow"
                        ToolTip="Развернуть" AutomationProperties.Name="Развернуть"/>
                <Button Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Click="CloseWindow" ToolTip="Закрыть"
                        AutomationProperties.Name="Закрыть"/>
            </StackPanel>
            <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,0,24,24">
                    <TextBlock Text="{Binding SelectedPage.Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding SelectedPage.Subtitle}" Style="{StaticResource MutedText}" FontSize="15" Margin="0,5,0,22"/>
                    <Grid>
                        <ContentControl Content="{Binding SelectedPage, NotifyOnTargetUpdated=True}" TargetUpdated="ResetPageScroll"
                                        IsEnabled="{Binding CanInteract}"
                                        Visibility="{Binding IsReady, Converter={StaticResource VisibleWhen}}"
                                        HorizontalContentAlignment="Stretch"/>
                        <Border Style="{StaticResource Card}" Visibility="{Binding IsReady, Converter={StaticResource HiddenWhen}}">
                            <StackPanel>
                                <TextBlock Text="Локальная база данных" Style="{StaticResource SectionTitle}"/>
                                <ProgressBar Height="4" IsIndeterminate="True" Foreground="{StaticResource Accent}" Margin="0,15,0,10"
                                             Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"/>
                                <Button Content="Повторить" Style="{StaticResource PrimaryButton}" Command="{Binding RetryCommand}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource HiddenWhen}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Margin="24,0,24,14" Padding="13,6" CornerRadius="9" BorderThickness="1"
                    Visibility="{Binding HasMessage, Converter={StaticResource VisibleWhen}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#203830"/>
                        <Setter Property="BorderBrush" Value="#345846"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Background" Value="#412934"/>
                                <Setter Property="BorderBrush" Value="#633646"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" FontSize="18" Style="{StaticResource LinkButton}"
                            Command="{Binding DismissCommand}" AutomationProperties.Name="Закрыть сообщение"/>
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
            </Border>
            <ProgressBar Grid.Row="2" VerticalAlignment="Bottom" Height="2" IsIndeterminate="True" Foreground="{StaticResource Accent}"
                         BorderThickness="0" Background="{StaticResource Canvas}"
                         Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"/>
        </Grid>
    </Grid>
</Window>
