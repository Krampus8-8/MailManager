<UserControl x:Class="MailManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource PageFade}">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Значения по умолчанию" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                <UniformGrid Columns="3" Margin="-5,0">
                    <StackPanel Margin="5,0">
                        <TextBlock Text="Длина логина (6–30)" Style="{StaticResource FieldTitle}"/>
                        <TextBox Text="{Binding LoginLength, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" AutomationProperties.Name="Длина логина"/>
                    </StackPanel>
                    <StackPanel Margin="5,0">
                        <TextBlock Text="Длина пароля (12–128)" Style="{StaticResource FieldTitle}"/>
                        <TextBox Text="{Binding PasswordLength, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" AutomationProperties.Name="Длина пароля"/>
                    </StackPanel>
                    <StackPanel Margin="5,0">
                        <TextBlock Text="Очистка буфера (10–120 c)" Style="{StaticResource FieldTitle}"/>
                        <TextBox Text="{Binding ClipboardSeconds, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" AutomationProperties.Name="Очистка буфера"/>
                    </StackPanel>
                </UniformGrid>
                <WrapPanel Margin="0,15,0,0">
                    <Button Content="Сохранить настройки" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Стандартные значения" Command="{Binding ResetCommand}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Хранилище" Style="{StaticResource SectionTitle}" Margin="0,0,0,13"/>
                <TextBlock Text="Файл базы данных" Style="{StaticResource FieldTitle}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Копировать путь" Command="{Binding CopyPathCommand}" Margin="8,0,0,0"/>
                    <TextBox Text="{Binding DataPath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Файл базы данных"/>
                </DockPanel>
                <TextBlock Text="Сохранённые пароли зашифрованы Windows DPAPI." Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
